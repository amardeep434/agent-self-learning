{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash '__SL_SCRIPTS_DIR__/session-start-context.sh'",
        "powershell": "bash -lc \"'__SL_SCRIPTS_DIR__/session-start-context.sh'\"",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bash '__SL_SCRIPTS_DIR__/copilot-session-review.sh'",
        "powershell": "bash -lc \"'__SL_SCRIPTS_DIR__/copilot-session-review.sh'\"",
        "timeoutSec": 30
      }
    ]
  }
}
