{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/self-learning/turn-counter.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/self-learning/session-review.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/self-learning/index-session.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
