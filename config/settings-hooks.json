{
  "env": {
    "SL_MEMORY_REVIEW_INTERVAL": "10",
    "SL_SKILL_REVIEW_INTERVAL": "10",
    "SL_REVIEW_ENABLED": "true",
    "SL_REVIEW_MIN_TURNS": "5",
    "SL_REVIEW_MAX_TURNS": "16"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__SL_SCRIPTS_DIR__/session-start-context.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__SL_SCRIPTS_DIR__/turn-counter.sh'",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__SL_SCRIPTS_DIR__/session-review.sh'",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash '__SL_SCRIPTS_DIR__/index-session.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
